{
  "$schema": "http://json.schemastore.org/template",
  "author": "zinmin@hotmail.com",
  "identity": "ASP.NET Core Web API with Scalar and Serilog",
  "name": "ASP.NET Core Web API (with Scalar and Serilog)",
  "description": "Official ASP.NET Core Web API Project Template with Scalar and Serilog",
  "shortName": "WebAPIWithScalarAndSerilog",
  "sourceName": "CustomWebAPIProject",
  "defaultName": "WebAPIProjectWithScalarAndSerilog",
  "preferNameDirectory": true,
  "classifications": [ "Web", "Web API", "Service" ],
  "tags": {
    "language": "C#",
    "type": "project",
    "vs_showParametersByDefault": "false"
  },
  "symbols": {
    "Framework": {
      "type": "parameter",
      "datatype": "choice",
      "description": "Target framework",
      "choices": [
        {
          "choice": "net10.0",
          "description": ".NET 10.0"
        }
      ],
      "defaultValue": "net10.0",
      "replaces": "net10.0"
    },
    "EnableSerilog": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "Write startup and application logs with Serilog."
    },
    "EnableScalar": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "Use Scalar UI for API Reference."
    }
  }
}
